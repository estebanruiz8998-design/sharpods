<title>SharpOds Tracker</title>
<style>
  :root {
    --paper: #EFF2EC; --card: #F7F8F4; --ink: #1A2321; --ink-soft: #55625C;
    --ink-faint: #8A958F; --felt: #0E5B43; --felt-soft: #0E5B4318;
    --stamp: #B3382E; --rule: #C9D1C8;
    --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
    --disp: "Arial Narrow", "Helvetica Neue", "Segoe UI", system-ui, sans-serif;
    --body: system-ui, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  @media (prefers-color-scheme: dark) { :root {
    --paper: #121713; --card: #1A211C; --ink: #E6EBE4; --ink-soft: #A7B2AA;
    --ink-faint: #6E7A72; --felt: #4CAE87; --felt-soft: #4CAE8722;
    --stamp: #D9584C; --rule: #2E3830;
  } }
  :root[data-theme="dark"] {
    --paper: #121713; --card: #1A211C; --ink: #E6EBE4; --ink-soft: #A7B2AA;
    --ink-faint: #6E7A72; --felt: #4CAE87; --felt-soft: #4CAE8722;
    --stamp: #D9584C; --rule: #2E3830;
  }
  :root[data-theme="light"] {
    --paper: #EFF2EC; --card: #F7F8F4; --ink: #1A2321; --ink-soft: #55625C;
    --ink-faint: #8A958F; --felt: #0E5B43; --felt-soft: #0E5B4318;
    --stamp: #B3382E; --rule: #C9D1C8;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink);
    font-family: var(--body); font-size: 16px; line-height: 1.45;
    -webkit-font-smoothing: antialiased; }
  .wrap { max-width: 560px; margin: 0 auto; padding: 32px 16px 56px; }

  .masthead { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 4px; }
  h1 { font-family: var(--disp); font-size: 24px; font-weight: 900;
    letter-spacing: .04em; text-transform: uppercase; margin: 0; }
  h1 span { color: var(--felt); }
  .sub { color: var(--ink-soft); font-size: 14px; margin: 0 0 20px; }

  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 14px; }
  .tile { background: var(--card); border: 1px solid var(--rule); border-radius: 10px;
    padding: 12px 8px 10px; text-align: center; }
  .tile .val { font-family: var(--mono); font-size: 24px; font-weight: 700;
    font-variant-numeric: tabular-nums; line-height: 1.2; }
  .tile .val.good { color: var(--felt); }
  .tile .val.bad { color: var(--stamp); }
  .tile .lbl { font-family: var(--disp); font-size: 10px; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase; color: var(--ink-faint); margin-top: 2px; }

  .stake { display: flex; justify-content: flex-end; align-items: center; gap: 8px;
    font-size: 13px; color: var(--ink-soft); margin-bottom: 20px; }
  .stake input { width: 84px; font-family: var(--mono); font-size: 15px;
    padding: 6px 8px; border: 1px solid var(--rule); border-radius: 8px;
    background: var(--card); color: var(--ink); text-align: right; }

  .day { font-family: var(--disp); font-size: 12px; font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint);
    margin: 18px 2px 8px; }
  .bet { background: var(--card); border: 1px solid var(--rule); border-radius: 12px;
    padding: 14px 14px 12px; margin-bottom: 10px; }
  .bet .top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .bet .pick { font-weight: 650; font-size: 16px; }
  .bet .odds { font-family: var(--mono); font-weight: 700; font-size: 16px;
    color: var(--felt); white-space: nowrap; }
  .bet .game { color: var(--ink-soft); font-size: 13px; margin: 1px 0 10px; }
  .bet .row { display: flex; gap: 8px; align-items: center; }
  .btn { flex: 1; border: 1.5px solid var(--rule); background: var(--paper);
    color: var(--ink-soft); border-radius: 9px; padding: 9px 0;
    font-family: var(--disp); font-weight: 700; font-size: 13px;
    letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .btn:focus-visible { outline: 3px solid var(--felt); outline-offset: 2px; }
  .btn[aria-pressed="true"].won { background: var(--felt); border-color: var(--felt); color: #fff; }
  .btn[aria-pressed="true"].lost { background: var(--stamp); border-color: var(--stamp); color: #fff; }
  .btn[aria-pressed="true"].nobet { background: var(--ink-soft); border-color: var(--ink-soft); color: var(--paper); }
  .pnl { min-width: 74px; text-align: right; font-family: var(--mono); font-size: 14px;
    font-weight: 700; font-variant-numeric: tabular-nums; color: var(--ink-faint); }
  .pnl.good { color: var(--felt); }
  .pnl.bad { color: var(--stamp); }

  .foot { display: flex; justify-content: space-between; align-items: center;
    margin-top: 24px; gap: 10px; flex-wrap: wrap; }
  .foot .note { font-size: 12px; color: var(--ink-faint); }
  .ghost { border: 1px solid var(--rule); background: transparent; color: var(--ink-soft);
    border-radius: 8px; padding: 7px 12px; font-family: var(--disp); font-weight: 700;
    font-size: 11px; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .ghost:focus-visible { outline: 3px solid var(--felt); outline-offset: 2px; }
</style>

<div class="wrap">
  <div class="masthead">
    <h1>Sharp<span>Ods</span> Tracker</h1>
  </div>
  <p class="sub">Tap what happened. The math does itself.</p>

  <div class="tiles" id="tiles"></div>

  <div class="stake">
    <label for="unitStake">$ per bet</label>
    <input type="number" id="unitStake" min="1" step="1" value="100">
  </div>

  <div id="bets"></div>

  <div class="foot">
    <span class="note" id="range"></span>
    <span style="display:flex;gap:8px">
      <button class="ghost" id="exportGrades">Save my record</button>
      <button class="ghost" id="clearGrades">Reset</button>
    </span>
  </div>
</div>

<script>
const DATA = __DATA_JSON__;

// Only playable picks — internals stay in the ledger.
const BETTABLE = new Set(["ticket", "order_open", "order_unfilled"]);
const picks = DATA.decisions.filter(d => BETTABLE.has(d.type) && (d.fill != null || d.target != null));

const GKEY = "sharpods-grades-v1";
const load = () => { try { return JSON.parse(localStorage.getItem(GKEY)) || {}; } catch { return {}; } };
const save = g => { try { localStorage.setItem(GKEY, JSON.stringify(g)); } catch {} };
let grades = load();

const stakeEl = document.getElementById("unitStake");
if (grades.__unit) stakeEl.value = grades.__unit;

const usd = v => (v < 0 ? "−$" : "+$") + Math.abs(Math.round(v)).toLocaleString("en-US");
const price = d => d.fill != null ? d.fill : d.target;
const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const nice = iso => MONTHS[+iso.slice(5, 7) - 1] + " " + (+iso.slice(8, 10));

// Bets list, newest day first
const bets = document.getElementById("bets");
let lastDay = "";
bets.innerHTML = [...picks].sort((a, b) => b.date.localeCompare(a.date)).map(d => {
  const day = d.date !== lastDay ? `<div class="day">${nice(d.date)}</div>` : "";
  lastDay = d.date;
  return day + `
  <div class="bet" data-id="${d.id}">
    <div class="top">
      <span class="pick">${d.selection}</span>
      <span class="odds">${price(d).toFixed(2)}</span>
    </div>
    <div class="game">${d.event}</div>
    <div class="row">
      <button class="btn won" data-mark="won" aria-pressed="false">Won</button>
      <button class="btn lost" data-mark="lost" aria-pressed="false">Lost</button>
      <button class="btn nobet" data-mark="nobet" aria-pressed="false">No bet</button>
      <span class="pnl" data-pnl></span>
    </div>
  </div>`;
}).join("");

function render() {
  const unit = Math.max(1, Number(stakeEl.value) || 100);
  let w = 0, l = 0, skip = 0, pnl = 0;
  document.querySelectorAll(".bet").forEach(card => {
    const d = picks.find(p => p.id === card.dataset.id);
    const mark = grades[d.id];
    card.querySelectorAll(".btn").forEach(b =>
      b.setAttribute("aria-pressed", String(b.dataset.mark === mark)));
    const out = card.querySelector("[data-pnl]");
    if (mark === "won") { const v = unit * (price(d) - 1); w++; pnl += v;
      out.textContent = usd(v); out.className = "pnl good"; }
    else if (mark === "lost") { l++; pnl -= unit;
      out.textContent = usd(-unit); out.className = "pnl bad"; }
    else if (mark === "nobet") { skip++; out.textContent = "$0"; out.className = "pnl"; }
    else { out.textContent = ""; out.className = "pnl"; }
  });
  const n = w + l;
  const tiles = [
    { val: `${w}–${l}`, lbl: "record" },
    { val: n ? Math.round(100 * w / n) + "%" : "—", lbl: "win rate" },
    { val: n ? usd(pnl) : "—", lbl: "profit", cls: pnl > 0 ? "good" : pnl < 0 ? "bad" : "" },
    { val: String(skip), lbl: "no bet" },
  ];
  document.getElementById("tiles").innerHTML = tiles.map(t =>
    `<div class="tile"><div class="val ${t.cls || ""}">${t.val}</div><div class="lbl">${t.lbl}</div></div>`).join("");
}

bets.addEventListener("click", e => {
  const btn = e.target.closest(".btn");
  if (!btn) return;
  const id = btn.closest(".bet").dataset.id;
  grades[id] = grades[id] === btn.dataset.mark ? undefined : btn.dataset.mark;
  if (grades[id] === undefined) delete grades[id];
  grades.__unit = Number(stakeEl.value) || 100;
  save(grades); render();
});
stakeEl.addEventListener("input", () => {
  grades.__unit = Number(stakeEl.value) || 100;
  save(grades); render();
});
document.getElementById("clearGrades").addEventListener("click", () => {
  grades = {}; save(grades); render();
});
document.getElementById("exportGrades").addEventListener("click", async () => {
  const payload = JSON.stringify({ unit_stake: Number(stakeEl.value) || 100,
    grades: Object.fromEntries(Object.entries(grades).filter(([k]) => k !== "__unit")) }, null, 2);
  if (window.claude && window.claude.downloads) {
    try { await window.claude.downloads.save({ filename: "sharpods-my-record.json", data: payload }); }
    catch (e) { /* declined or unavailable — nothing to clean up */ }
  }
});

const dates = DATA.dates;
document.getElementById("range").textContent =
  dates.length ? `${nice(dates[0])} – ${nice(dates[dates.length - 1])} · marks stay on this device` : "";
render();
</script>
